     }();
 
+    // The extra HDR formats the driver can back on the Gamescope (bypass)
+    // surface: CreateSwapchainKHR refuses any format the driver doesn't list
+    // for it, so advertising one it lacks (seen: A2R10G10B10 on NVIDIA) makes
+    // games pick a format that then fails swapchain creation.
+    template <typename T, size_t N, typename GetFormat>
+    static std::vector<T> SupportedExtraHDRFormats(
+      const vkroots::VkPhysicalDeviceDispatch & pDispatch,
+            VkPhysicalDevice             physicalDevice,
+            VkSurfaceKHR                 surface,
+      const std::array<T, N>&            extras,
+            GetFormat                    getFormat) {
+      std::vector<VkSurfaceFormatKHR> nativeFormats;
+      vkroots::enumerate(
+        std::bind_front(&vkroots::VkPhysicalDeviceDispatch::GetPhysicalDeviceSurfaceFormatsKHR, &pDispatch),
+        nativeFormats,
+        physicalDevice,
+        surface);
+
+      std::vector<T> supported;
+      for (const T& extra : extras) {
+        const VkFormat format = getFormat(extra);
+        if (std::ranges::any_of(nativeFormats, std::bind_front(std::equal_to{}, format), &VkSurfaceFormatKHR::format))
+          supported.push_back(extra);
+      }
+      return supported;
+    }
+
     static VkResult GetPhysicalDeviceSurfaceFormatsKHR(
       const vkroots::VkPhysicalDeviceDispatch & pDispatch,
             VkPhysicalDevice             physicalDevice,
