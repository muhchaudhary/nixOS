+    // Nested gamescope used to unmap its window whenever nothing was focused,
+    // so the host window closed and reopened on every game exit (default size,
+    // open animation, then fullscreen), and sometimes never came back. Instead
+    // keep the last buffer attached and only re-commit it with damage, still
+    // asking for presentation feedback so vblank timing and commit release go on.
+    void CWaylandPlane::HoldFrame()
+    {
+        if ( !m_pFrame || !m_bHasAttachedBuffer || m_bUnmappedAwaitingConfigure )
+            return;
+
+        struct wp_presentation_feedback *pFeedback = wp_presentation_feedback( m_pBackend->GetPresentation(), m_pSurface );
+        wp_presentation_feedback_add_listener( pFeedback, &s_PresentationFeedbackListener, this );
+        wl_surface_damage( m_pSurface, 0, 0, INT32_MAX, INT32_MAX );
+    }
