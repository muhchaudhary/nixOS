+static void caretBlinkCallback(AWP<CPasswordInputField> ref) {
+    if (const auto PP = ref.lock(); PP)
+        PP->onCaretTimer();
+}
+
+// The caret blinks like a terminal cursor, staying solid right after a keystroke.
+void CPasswordInputField::onCaretTimer() {
+    hiddenInputState.caretVisible = !hiddenInputState.caretVisible;
+    hiddenInputState.caretTimer   = g_pHyprlock->addTimer(std::chrono::milliseconds(530), [REF = m_self](auto, auto) { caretBlinkCallback(REF); }, nullptr);
+    g_pHyprlock->renderOutput(outputStringPort);
+}
+
+void CPasswordInputField::restartCaretBlink() {
+    if (hiddenInputState.caretTimer)
+        hiddenInputState.caretTimer->cancel();
+    hiddenInputState.caretVisible = true;
+    hiddenInputState.caretTimer   = g_pHyprlock->addTimer(std::chrono::milliseconds(530), [REF = m_self](auto, auto) { caretBlinkCallback(REF); }, nullptr);
+}
